# Payments & Credit Decisioning Workbench
# Leave NVIDIA_API_KEY empty to use the mock rationale.
# Do not commit a real key.
# Docker Compose reads payments-credit-decisioning/.env for the same values.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
DECISION_LLM_MODE=auto
