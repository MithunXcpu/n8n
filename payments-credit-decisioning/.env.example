# Local demo only. Do not put a real key in git.
# Leave NVIDIA_API_KEY empty to use the mock rationale.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# auto calls NVIDIA only for review cases when NVIDIA_API_KEY is set.
# mock never calls NVIDIA. nvidia calls NVIDIA for every review case.
DECISION_LLM_MODE=auto

# Editor login for the local n8n instance. This is a demo password.
DEMO_OWNER_EMAIL=demo.owner@example.com
DEMO_OWNER_PASSWORD=DecisionDemo123!
